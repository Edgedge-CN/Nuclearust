alsoTriggerAction:register
fireTurretXAtGround:select
fireTurretXAtGround_withOffset:0,0
debugMessage:A new web created on%{self.id}
[hiddenAction_connectToWeb]
#也许叫system更好一点
requireConditional:if memory.source!=null and memory.source!=self
#应该用达摩根()
setUnitMemory:root=memory.source.readUnitMemory('root',type='unit')
sendMessageTo:memory.source
sendMessageWithTags:requestChi
#alsoTriggerAction:appendChild 错误的
alsoTriggerAction:updateState,register
debugMessage:%{self.id}connect web(rootId)%{memory.root.id}
[hiddenAction_appendChild]
autoTriggerOnEvent:newMessage(withTag='requestChi')
shrinkArrays:child,connectServices,queueNodes
setUnitMemory:child[memory.child.size]=eventSource
alsoTriggerAction:updateState
debugMessage:%{self.id}append%{eventSource.id}as%{memory.child.size}
#用alsoTrigger统一更新偷个懒
[hiddenAction_register]
sendMessageTo:memory.root
sendMessageWithTags:registerRequest
#此节可简化
debugMessage:%{self.id}registerReq to %{memory.root.id}
[hiddenAction_updateState]
highPriorityQueue:true
#卧槽我都写state了还用connect-able
setUnitMemory:connectable=(memory.queueNodes.size+memory.child.size+memory.connectServices.size+select(memory.source == null,0,1))<${maxConnection}
shrinkArrays:child,connectServices,queueNodes
#debugMessage:%{self.id}Updated,%{memory.connectable}
[hiddenAction_queueNew(function)]
#q(type,target)
debugMessage:queueNewOn%{self.id},target%{eventSource.id}
autoTriggerOnEvent:newMessage(withTag='connectRequest')
requireConditional:if eventSource==self and memory.connectable
setUnitMemory:"""queueNodes[memory.queueNodes.size]=select(eventData('node',type='unit')==null,memory.queueNodes[memory.queueNodes.size],eventData('node',type='unit')),
connectServices[memory.connectServices.size]=select(eventData('ser',type='unit')==null,memory.connectServices[memory.connectServices.size],eventData('ser',type='unit'))
"""
alsoTriggerAction:reunionWebTrigger
[hiddenAction_disconnectWeb]
#断连重组
autoTrigger:if memory.source == null
spawnUnits:webStorage
setUnitMemory:source=self,root=nearestUnit(withinRange=20,withTag='elesto'),index=0
alsoTriggerAction:updateState,reflushRoot,reunionProcess2
[hiddenAction_reflushRoot]
debugMessage:reflushMainOn%{self.id}
autoTriggerOnEventRecursionLimit:32
sendMessageTo:memory.child[memory.index]
sendMessageWithTags:reflushSource
alsoTriggerAction:reflushRoot
setUnitMemory:index=select(memory.index==memory.child.size,-1,memory.index+1)
requireConditional:if memory.index!=-1
#循环石山
[hiddenAction_reflushRoot0]
debugMessage:reflushRetOn%{self.id}
autoTriggerOnEvent:newMessage(withTag='reflushSourse')
alsoTriggerAction:updateState,connectToWeb
#其实这里完全没有必要 这里单独立一节只是为了让逻辑清晰一点 避免写晕
[hiddenAction_reunionWebTrigger]
#神秘洋屁reunion
requireConditional:if memory.queueNodes[memory.queueNodes.size].readUnitMemory('root',type='unit') != memory.root
alsoTriggerAction:reunionPrepare,updateState
[hiddenAction_reunionPrepare]
debugMessage:prepareRUOn%{self.id}
sendMessageTo:memory.root
sendMessageWithData:new=memory.queueNodes[memory.queueNodes.size].readUnitMemory('root',type='unit')
sendMessageWithTags:reunion
[hiddenAction_reunionContru]
debugMessage:reunionCOn%{self.id}
autoTriggerOnEvent:newMessage(withTag='reunionC')
setUnitMemory:rootNew=eventData('ntarget',type='unit')
[hiddenAction_reunionProcess]
setUnitMemory:source=select(memory.rootNew==memory.root,memory.source,memory.queueNodes[memory.queueNodes.size])
alsoTriggerAction:reflushRoot
[hiddenAction_reunionProcess2]
setUnitMemory:source=select(memory.rootNew==memory.root,memory.source,memory.child[memory.child.size]),index=0
alsoQueueAction:updateState,connectToWeb,reflushRoot,fkluke
[hiddenAction_fkluke]
setUnitMemory:queueNodes=null
requireConditional:if memory.rootNew==memory.root
