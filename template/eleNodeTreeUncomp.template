[hiddenAction_init]
autoTriggerOnEvent:created
#takeResources_includeReference:
setUnitMemory:source=nearestUnit(withinRange=${maxRange},withTag='node')
alsoTriggerAction:newWeb,connectToWeb
debugMessage:%{self.id} initStarted,source=%{memory.source.id}
[hiddenAction_newWeb]
requireConditional:if memory.source==null
#spawnUnits:webStorage
addUnitsIntoTransport:webStorage
