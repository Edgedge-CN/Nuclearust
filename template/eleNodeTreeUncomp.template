@memory source:unit
#自己通过连接谁连接到了一个网络
@memory root:unit
#网络数据寄存对象
@memory child:unit[]
#谁(节点)连接到了自己
@memory connectServices:unit[]
#连接设备
@memory queueNodes:unit[]
#待连节点(显示但是没有实际建立连接)
@memory connectable:bool
#哦不我的塑料英语 所以到底有没有connectable 感觉没有() 算了反正老子写的老子来命名
@memory index:number
#有没有int有没有int有没有int
@memory rootNew:unit
